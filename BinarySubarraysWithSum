class BinarySubarraysWithSum{
    public int atmostK(int[] nums, int k) {
        int n=nums.length;
        int temp=0;
        int ans=0;
        int l=0;
        if(k<0){
            return 0;
        }
        for(int r=0;r<n;r++)
        {
            temp=temp+nums[r];
            while(temp>k){
                temp-=nums[l];
                l++;
            }
            ans+=r-l+1;
        }
        return ans;
    }
    public int numberOfSubarrays(int[] nums,int k){
        int finalAns=atmostK(nums,k)-atmostK(nums,k-1);
        return finalAns;
    }
    public static void main(String[] args)
    {
        int[] nums={1,0,1,0,1};
        int k=2;
        BinarySubarraysWithSum s=new BinarySubarraysWithSum();
        System.out.println(s.numberOfSubarrays(nums,k));
    }
}
